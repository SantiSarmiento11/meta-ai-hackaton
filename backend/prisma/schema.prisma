datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CEO
  ADMIN
  OPERATOR
}

enum OperatingMode {
  DAY
  NIGHT
}

enum AgentCode {
  COWORKER
  ASSISTANT
  MANAGER
}

enum AgentStatus {
  IDLE
  WORKING
  ERROR
  PAUSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskOperatingMode {
  AWAKE
  SLEEP
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CEO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offices             Office[]
  agents              Agent[]
  tasks               Task[]
  integrationCredentials IntegrationCredential[]
  automationWorkflows AutomationWorkflow[]

  @@map("users")
}

model Office {
  id               String        @id @default(uuid())
  userId           String
  name             String        @default("Oficina Central Sleeply")
  currentMode      OperatingMode @default(DAY)
  selectedAvatarId String        @default("char_0")
  zoomLevel        Float         @default(1.0)
  isGridVisible    Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  objects          OfficeObject[]

  @@map("offices")
}

model OfficeObject {
  id         String   @id @default(uuid())
  officeId   String
  objectId   String   // Identificador del catálogo (ej. modern_office_01, tech_office_15)
  instanceId String   // Identificador de instancia en el cliente Phaser
  col        Int
  row        Int
  width      Int
  height     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  office     Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, instanceId])
  @@map("office_objects")
}

model Agent {
  id           String      @id @default(uuid())
  userId       String
  code         AgentCode
  name         String
  description  String
  avatar       String
  status       AgentStatus @default(IDLE)
  instructions String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([userId, code])
  @@map("agents")
}

model Task {
  id           String            @id @default(uuid())
  userId       String
  agentId      String?
  title        String
  description  String
  status       TaskStatus        @default(PENDING)
  mode         TaskOperatingMode @default(AWAKE)
  priority     String            @default("medium")
  result       String?
  scheduledFor DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  executionLogs TaskExecutionLog[]

  @@map("tasks")
}

model TaskExecutionLog {
  id          String   @id @default(uuid())
  taskId      String
  status      String
  message     String
  rawPayload  Json?
  executedAt  DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_execution_logs")
}

model IntegrationCredential {
  id              String   @id @default(uuid())
  userId          String
  serviceName     String   // e.g. "n8n", "meta_ai", "custom"
  keyName         String   // e.g. "default", "production_webhook"
  credentialKey   String
  encryptedSecret String
  metadata        Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceName, keyName])
  @@map("integration_credentials")
}

model AutomationWorkflow {
  id             String    @id @default(uuid())
  userId         String
  name           String
  n8nWorkflowId  String?
  n8nWebhookUrl  String
  triggerEvent   String    @default("manual")
  isActive       Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("automation_workflows")
}
